{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsc-app",
    "tsBuildInfoFile": "./node_modules/.cache/tsc-app.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src", "tests/unit", "src/**/*.json", "data/rates/*.json"]
}
