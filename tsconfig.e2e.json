{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsc-e2e",
    "tsBuildInfoFile": "./node_modules/.cache/tsc-e2e.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["tests/e2e", "playwright.config.ts", "src/core/types.ts"]
}
